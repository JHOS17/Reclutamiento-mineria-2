#!/bin/bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
ZONE=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

mkdir -p /opt/plataforma/html

cat > /opt/plataforma/html/index.html <<HTML
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><title>Reclutamiento Minero</title></head>
<body>
<h1>Plataforma Global de Reclutamiento Minero</h1>
<p>Infraestructura base desplegada con Terraform: VPC en dos zonas, Application Load Balancer, Auto Scaling con EC2 y Docker, RDS y S3.</p>
<p>Instancia $INSTANCE_ID en la zona $ZONE</p>
</body>
</html>
HTML

cat > /opt/plataforma/nginx.conf <<'NGINX'
server {
    listen 80;

    location = /api/health {
        default_type application/json;
        return 200 '{"status":"UP"}';
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}
NGINX

docker run -d --name web --restart unless-stopped -p 80:80 \
  -v /opt/plataforma/nginx.conf:/etc/nginx/conf.d/default.conf:ro \
  -v /opt/plataforma/html:/usr/share/nginx/html:ro \
  --log-driver=awslogs --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream="$INSTANCE_ID" \
  public.ecr.aws/nginx/nginx:stable-alpine
